<Window
    x:Class="Moonlight.Gui.Demo.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moonlight.Gui.Demo"
    xmlns:views="using:Moonlight.Gui.Demo.Views"
    Title="wallet_1 (#0) - Moonlight Demo"
    Width="977"
    Height="499"
    MinWidth="760"
    MinHeight="460"
    WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="22,*,28" Background="{StaticResource Ground}">

    <Menu Grid.Row="0">
      <MenuItem Header="File">
        <MenuItem Header="Recently open" />
        <MenuItem Header="Open wallet" Click="MenuAction" />
        <MenuItem Header="New/Restore" Click="MenuAction" />
        <MenuItem Header="Lock wallet" Click="MenuAction" />
        <MenuItem Header="Close wallet" Click="MenuAction" />
        <MenuItem Header="Quit application" Click="Quit" />
        <Separator />
        <MenuItem Header="Settings" Click="MenuAction" />
      </MenuItem>
      <MenuItem Header="Wallet">
        <MenuItem Header="Information" Click="MenuAction" />
        <MenuItem Header="Advanced">
          <MenuItem Header="Save wallet" Click="MenuAction" />
          <MenuItem Header="Update balance" Click="MenuAction" />
          <MenuItem Header="Refresh models" Click="MenuAction" />
          <MenuItem Header="Rescan spent" Click="MenuAction" />
          <MenuItem Header="Wallet cache debug" Click="MenuAction" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Account" Click="MenuAction" />
        <MenuItem Header="Password" Click="MenuAction" />
        <MenuItem Header="Seed" Click="MenuAction" />
        <MenuItem Header="Keys" Click="MenuAction" />
        <MenuItem Header="View-Only" Click="MenuAction" />
        <Separator />
        <MenuItem Header="History"><MenuItem Header="Export CSV" Click="MenuAction" /><MenuItem Header="Import descriptions from CSV" Click="MenuAction" /></MenuItem>
      </MenuItem>
      <MenuItem Header="View">
        <MenuItem Header="Home" ToggleType="CheckBox" IsChecked="True" />
        <MenuItem Header="Coins" ToggleType="CheckBox" IsChecked="True" />
        <MenuItem Header="Contacts" ToggleType="CheckBox" IsChecked="True" />
        <Separator />
        <MenuItem Header="Show Searchbar" ToggleType="CheckBox" IsChecked="True" />
      </MenuItem>
      <MenuItem Header="Tools">
        <MenuItem Header="Sign/verify message" Click="MenuAction" />
        <MenuItem Header="Verify transaction proof" Click="MenuAction" />
        <Separator />
        <MenuItem Header="Offline transaction signing" Click="MenuAction" />
        <MenuItem Header="Broadcast transaction"><MenuItem Header="From file" Click="MenuAction" /><MenuItem Header="From text" Click="MenuAction" /></MenuItem>
        <MenuItem Header="Import transaction" Click="MenuAction" />
        <Separator />
        <MenuItem Header="Transmit over UR" Click="MenuAction" />
        <Separator />
        <MenuItem Header="Pay to many" Click="MenuAction" />
        <MenuItem Header="Address checker" Click="MenuAction" />
        <MenuItem Header="Create desktop entry" Click="MenuAction" />
        <MenuItem Header="Tx pool viewer" Click="MenuAction" />
      </MenuItem>
      <MenuItem Header="Help">
        <MenuItem Header="About Moonlight" Click="MenuAction" />
        <MenuItem Header="Check for updates" Click="MenuAction" />
        <MenuItem Header="Official website" Click="MenuAction" />
        <Separator />
        <MenuItem Header="Documentation" Click="MenuAction" />
        <MenuItem Header="Report bug" Click="MenuAction" />
        <MenuItem Header="Debug info" Click="MenuAction" />
      </MenuItem>
    </Menu>

    <Grid Grid.Row="1" ColumnDefinitions="72,*">

      <Border Grid.Column="0" Background="{StaticResource Deep}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,0,1,0">
        <StackPanel Margin="0,4,0,0">
          <Button x:Name="HomeTab" Classes="tab active" Click="ShowHome"><Grid ColumnDefinitions="2,*,2"><Border Classes="rail-mark" /><StackPanel Grid.Column="1" Spacing="4"><PathIcon Data="M2,7.2 8,2.2 14,7.2 12.4,7.2 12.4,14 3.6,14 3.6,7.2z M6.4,9.4h3.2v4.6H6.4z" /><TextBlock Classes="micro" Text="Home" /></StackPanel></Grid></Button>
          <Button x:Name="HistoryTab" Classes="tab" Click="ShowHistory"><Grid ColumnDefinitions="2,*,2"><Border Classes="rail-mark" /><StackPanel Grid.Column="1" Spacing="4"><PathIcon Data="M8,1a7,7 0 1,0 0,14A7,7 0 0,0 8,1z M8,2.6A5.4,5.4 0 1,1 8,13.4 5.4,5.4 0 1,1 8,2.6z M7.3,4.4h1.4v3.9h3.2v1.4H7.3z" /><TextBlock Classes="micro" Text="History" /></StackPanel></Grid></Button>
          <Button x:Name="SendTab" Classes="tab" Click="ShowSend"><Grid ColumnDefinitions="2,*,2"><Border Classes="rail-mark" /><StackPanel Grid.Column="1" Spacing="4"><PathIcon Data="M1,2 15,8 1,14 3.5,9.2 10,8 3.5,6.8z" /><TextBlock Classes="micro" Text="Send" /></StackPanel></Grid></Button>
          <Button x:Name="ReceiveTab" Classes="tab" Click="ShowReceive"><Grid ColumnDefinitions="2,*,2"><Border Classes="rail-mark" /><StackPanel Grid.Column="1" Spacing="4"><PathIcon Data="M7,1h2v8l3-3 1.5,1.5L8,13 2.5,7.5 4,6l3,3z M2,13h12v2H2z" /><TextBlock Classes="micro" Text="Receive" /></StackPanel></Grid></Button>
          <Button x:Name="CoinsTab" Classes="tab" Click="ShowCoins"><Grid ColumnDefinitions="2,*,2"><Border Classes="rail-mark" /><StackPanel Grid.Column="1" Spacing="4"><PathIcon Data="M8,1c3.9,0 7,1.3 7,3s-3.1,3-7,3-7-1.3-7-3 3.1-3 7-3z M1,6.5C2.5,8 5,8.7 8,8.7s5.5-.7 7-2.2V9c0,1.7-3.1,3-7,3s-7-1.3-7-3z M1,11.5C2.5,13 5,13.7 8,13.7s5.5-.7 7-2.2V13c0,1.7-3.1,3-7,3s-7-1.3-7-3z" /><TextBlock Classes="micro" Text="Coins" /></StackPanel></Grid></Button>
          <Button x:Name="ContactsTab" Classes="tab" Click="ShowContacts"><Grid ColumnDefinitions="2,*,2"><Border Classes="rail-mark" /><StackPanel Grid.Column="1" Spacing="4"><PathIcon Data="M3,1h10v14H3z M1,3h2v2H1z M1,7h2v2H1z M1,11h2v2H1z M8,4a2,2 0 1,1 0,4 2,2 0 0,1 0-4z M5,12c0-2 1.3-3 3-3s3,1 3,3z" /><TextBlock Classes="micro" Text="Contacts" /></StackPanel></Grid></Button>
        </StackPanel>
      </Border>

      <Grid Grid.Column="1">

        <Grid x:Name="HomePage" Margin="12,11,12,12" RowDefinitions="Auto,11,Auto,*">

          <Grid ColumnDefinitions="*,9,*,9,*,26,138">
            <Border Classes="panel" Padding="9,6"><StackPanel Spacing="4"><TextBlock Classes="micro" Text="XMR" /><Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Text="€201.19" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Positive}" Text="+0.9%" /></Grid></StackPanel></Border>
            <Border Grid.Column="2" Classes="panel" Padding="9,6"><StackPanel Spacing="4"><TextBlock Classes="micro" Text="BTC" /><Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Text="€77892.25" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Positive}" Text="+3.4%" /></Grid></StackPanel></Border>
            <Border Grid.Column="4" Classes="panel" Padding="9,6"><StackPanel Spacing="4"><TextBlock Classes="micro" Text="XMR/BTC" /><Grid ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Text="0.002583" /><TextBlock Grid.Column="1" VerticalAlignment="Center" Foreground="{StaticResource Negative}" Text="-2.5%" /></Grid></StackPanel></Border>
            <Border Grid.Column="6" Classes="panel" Padding="9,6"><StackPanel Spacing="4"><TextBlock Classes="micro" Text="Balance" /><TextBlock VerticalAlignment="Center" Classes="amount" Text="€4.02" /></StackPanel></Border>
          </Grid>

          <Border Grid.Row="2" Classes="panel" Padding="14,11">
            <Grid ColumnDefinitions="*,*,*" >
              <StackPanel Spacing="7">
                <TextBlock Classes="micro" Text="Wallet" />
                <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,5,Auto,5,Auto">
                  <TextBlock Classes="dim" Text="Status" /><TextBlock Grid.Column="1" Foreground="{StaticResource Positive}" Text="Synchronized" />
                  <TextBlock Grid.Row="2" Classes="dim" Text="Height" /><TextBlock Grid.Row="2" Grid.Column="1" Text="3 380 455" />
                  <TextBlock Grid.Row="4" Classes="dim" Text="Node" /><TextBlock Grid.Row="4" Grid.Column="1" Text="127.0.0.1:18081" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="7">
                <TextBlock Classes="micro" Text="Balance" />
                <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,5,Auto,5,Auto">
                  <TextBlock Classes="dim" Text="Available" /><TextBlock Grid.Column="1" Classes="amount" Text="0.009959" />
                  <TextBlock Grid.Row="2" Classes="dim" Text="Locked" /><TextBlock Grid.Row="2" Grid.Column="1" Foreground="#D9A441" Text="0.010000" />
                  <TextBlock Grid.Row="4" Classes="dim" Text="Frozen" /><TextBlock Grid.Row="4" Grid.Column="1" Foreground="#6B8FC7" Text="0.000010" />
                </Grid>
              </StackPanel>
              <StackPanel Grid.Column="2" Spacing="7">
                <TextBlock Classes="micro" Text="Outputs" />
                <Grid ColumnDefinitions="86,*" RowDefinitions="Auto,5,Auto,5,Auto">
                  <TextBlock Classes="dim" Text="Spendable" /><TextBlock Grid.Column="1" Text="3" />
                  <TextBlock Grid.Row="2" Classes="dim" Text="Locked" /><TextBlock Grid.Row="2" Grid.Column="1" Text="1" />
                  <TextBlock Grid.Row="4" Classes="dim" Text="Frozen" /><TextBlock Grid.Row="4" Grid.Column="1" Text="1" />
                </Grid>
              </StackPanel>
            </Grid>
          </Border>

          <Border Grid.Row="3" />
        </Grid>

        <views:HistoryView x:Name="HistoryPage" IsVisible="False" />

        <Grid x:Name="SendPage" IsVisible="False" Margin="12,12,12,12"
              ColumnDefinitions="80,*" ColumnSpacing="12"
              RowDefinitions="44,11,25,11,25,11,25,11,25,*">

          <TextBlock Grid.Row="0" VerticalAlignment="Center" Classes="micro" Text="Pay to" />
          <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,82" ColumnSpacing="9">
            <TextBox x:Name="PayToBox" Height="44" AcceptsReturn="True" TextWrapping="NoWrap" PlaceholderText="Paste address, payment URI, OpenAlias, or QR code" />
            <Button Grid.Column="1" VerticalAlignment="Bottom" Click="ScanPayment"><StackPanel Orientation="Horizontal" Spacing="6"><PathIcon Width="12" Height="12" Foreground="{StaticResource Muted}" Data="M1,1h5v2H3v3H1z M10,1h5v5h-2V3h-3z M1,10h2v3h3v2H1z M13,10h2v5h-5v-2h3z M6,6h4v4H6z" /><TextBlock Text="Scan" /></StackPanel></Button>
          </Grid>

          <TextBlock Grid.Row="2" VerticalAlignment="Center" Classes="micro" Text="Description" />
          <TextBox x:Name="DescriptionBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Optional note, kept only in this wallet" />

          <TextBlock Grid.Row="4" VerticalAlignment="Center" Classes="micro" Text="Amount" />
          <Grid Grid.Row="4" Grid.Column="1" ColumnDefinitions="124,74,64,Auto,Auto,*" ColumnSpacing="9">
            <TextBox x:Name="AmountBox" TextChanged="AmountChanged" />
            <ComboBox Grid.Column="1" HorizontalAlignment="Stretch" SelectedIndex="0"><ComboBoxItem Content="XMR" /><ComboBoxItem Content="USD" /></ComboBox>
            <Button Grid.Column="2" Click="UseMaximum">Max</Button>
            <TextBlock x:Name="ConversionText" Grid.Column="3" VerticalAlignment="Center" Classes="dim" />
            <CheckBox Grid.Column="4" VerticalAlignment="Center" Content="Subtract fee from amount" />
          </Grid>

          <TextBlock Grid.Row="6" VerticalAlignment="Center" Classes="micro" Text="Fee" />
          <ComboBox x:Name="FeePriorityBox" Grid.Row="6" Grid.Column="1" Width="188" HorizontalAlignment="Left" SelectedIndex="0"><ComboBoxItem Content="Automatic" /><ComboBoxItem Content="Low" /><ComboBoxItem Content="Normal" /><ComboBoxItem Content="High" /><ComboBoxItem Content="Highest" /></ComboBox>

          <StackPanel x:Name="SendActions" Grid.Row="8" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Click="ResolveAlias">Resolve OpenAlias</Button><Button Click="ClearSend">Clear</Button><Button IsEnabled="False">Send</Button>
          </StackPanel>
        </Grid>

        <views:ReceiveView x:Name="ReceivePage" IsVisible="False" />

        <views:CoinsView x:Name="CoinsPage" IsVisible="False" />

        <views:ContactsView x:Name="ContactsPage" IsVisible="False" />



      </Grid>
    </Grid>

    <Border Grid.Row="2" Background="{StaticResource Deep}" BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
      <Grid Margin="12,0,10,0" ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
          <Ellipse Width="5" Height="5" VerticalAlignment="Center" Fill="{StaticResource Positive}" />
          <TextBlock x:Name="StatusText" VerticalAlignment="Center" Classes="muted" Text="Synchronized" />
        </StackPanel>
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0" Classes="dim" Text="Balance" />
        <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0" Text="0.019969 XMR (€4.02)" />
        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2" VerticalAlignment="Center">
          <Button Classes="status-icon" ToolTip.Tip="Connected"><PathIcon Foreground="{StaticResource Positive}" Data="M8,1a7,7 0 1,0 0,14A7,7 0 0,0 8,1z M8,3a5,5 0 1,1 0,10A5,5 0 0,1 8,3z M8,5.5a2.5,2.5 0 1,0 0,5 2.5,2.5 0 0,0 0-5z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Account"><PathIcon Foreground="{StaticResource Accent}" Data="M8,1a3,3 0 1,1 0,6 3,3 0 0,1 0-6z M2,15c0-4 2-6 6-6s6,2 6,6z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Password"><PathIcon Foreground="#B08A4A" Data="M8,1 A4,4 0 0,1 12,5 V7.5 H10.4 V5 A2.4,2.4 0 0,0 5.6,5 V7.5 H4 V5 A4,4 0 0,1 8,1 Z M2.8,7.5 H13.2 V15 H2.8 Z M7.2,9.8 h1.6 v3.4 h-1.6 z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Settings"><PathIcon Foreground="{StaticResource Muted}" Data="M7,1h2l.5,2a6,6 0 0,1 1.4.8l2-.6 1,1.8-1.5,1.4c.1.5.1,1 0,1.6l1.5,1.4-1,1.8-2-.6a6,6 0 0,1-1.4.8l-.5,2H7l-.5-2a6,6 0 0,1-1.4-.8l-2,.6-1-1.8L3.6,8a6,6 0 0,1 0-1.6L2.1,5l1-1.8 2,.6A6,6 0 0,1 6.5,3z M8,5a3,3 0 1,0 0,6 3,3 0 0,0 0-6z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Seed"><PathIcon Foreground="#7E9B4C" Data="M7.3,15 V8 h1.4 V15 z M2.6,3.4 C6.2,3.8 8,5.8 8,8.6 C5.2,8.6 3,6.6 2.6,3.4 Z M13.4,2.4 C9.8,2.8 8,4.8 8,7.6 C10.8,7.6 13,5.6 13.4,2.4 Z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Proxy"><PathIcon Foreground="{StaticResource Positive}" Data="M8,1 14,3.4 V8 c0,3.7-2.7,5.9-6,7-3.3-1.1-6-3.3-6-7 V3.4 Z M8,3.2 3.6,4.6 V8 c0,2.6,1.8,4.2,4.4,5.2 2.6-1 4.4-2.6 4.4-5.2 V4.6 Z" /></Button>
          <Button Classes="status-icon" IsVisible="False" ToolTip.Tip="Hardware device"><PathIcon Foreground="{StaticResource Muted}" Data="M6,1h4v4h2v3h-1v4H9v3H7v-3H5V8H4V5h2z M7,3v2h2V3z M7,8v2h2V8z" /></Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
