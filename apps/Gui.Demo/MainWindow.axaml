<Window
    x:Class="Moonlight.Gui.Demo.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Moonlight.Gui.Demo"
    xmlns:views="using:Moonlight.Gui.Demo.Views"
    Title="wallet_1 (#0) - Moonlight"
    Width="835"
    Height="469"
    MinWidth="760"
    MinHeight="460"
    WindowStartupLocation="CenterScreen">

  <Grid RowDefinitions="22,31,*,31" Background="#EFF0F1">
    <Menu Grid.Row="0">
      <MenuItem Header="File">
        <MenuItem Header="Recently open" />
        <MenuItem Header="Open wallet" Click="MenuAction" />
        <MenuItem Header="New/Restore" Click="MenuAction" />
        <MenuItem Header="Lock wallet" Click="MenuAction" />
        <MenuItem Header="Close wallet" Click="MenuAction" />
        <MenuItem Header="Quit application" Click="Quit" />
        <Separator />
        <MenuItem Header="Settings" Click="MenuAction" />
      </MenuItem>
      <MenuItem Header="Wallet">
        <MenuItem Header="Information" Click="MenuAction" />
        <MenuItem Header="Advanced">
          <MenuItem Header="Save wallet" Click="MenuAction" />
          <MenuItem Header="Update balance" Click="MenuAction" />
          <MenuItem Header="Refresh models" Click="MenuAction" />
          <MenuItem Header="Rescan spent" Click="MenuAction" />
        </MenuItem>
        <Separator />
        <MenuItem Header="Account" Click="MenuAction" />
        <MenuItem Header="Password" Click="MenuAction" />
        <MenuItem Header="Seed" Click="MenuAction" />
        <MenuItem Header="Keys" Click="MenuAction" />
        <MenuItem Header="View-Only" Click="MenuAction" />
        <Separator />
        <MenuItem Header="History"><MenuItem Header="Export CSV" Click="MenuAction" /><MenuItem Header="Import descriptions from CSV" Click="MenuAction" /></MenuItem>
      </MenuItem>
      <MenuItem Header="View">
        <MenuItem Header="Home" ToggleType="CheckBox" IsChecked="True" />
        <MenuItem Header="Coins" ToggleType="CheckBox" IsChecked="True" />
        <MenuItem Header="Notes" ToggleType="CheckBox" IsChecked="True" />
        <Separator />
        <MenuItem Header="Show Searchbar" ToggleType="CheckBox" IsChecked="True" />
      </MenuItem>
      <MenuItem Header="Tools">
        <MenuItem Header="Sign/verify message" Click="MenuAction" />
        <MenuItem Header="Verify transaction proof" Click="MenuAction" />
        <Separator />
        <MenuItem Header="Offline transaction signing" Click="MenuAction" />
        <MenuItem Header="Broadcast transaction"><MenuItem Header="From file" Click="MenuAction" /><MenuItem Header="From text" Click="MenuAction" /></MenuItem>
        <MenuItem Header="Import transaction" Click="MenuAction" />
        <Separator />
        <MenuItem Header="Pay to many" Click="MenuAction" />
        <MenuItem Header="Address checker" Click="MenuAction" />
        <MenuItem Header="Tx pool viewer" Click="MenuAction" />
      </MenuItem>
      <MenuItem Header="Help">
        <MenuItem Header="About Moonlight" Click="MenuAction" />
        <MenuItem Header="Check for updates" Click="MenuAction" />
        <MenuItem Header="Official website" Click="MenuAction" />
        <Separator />
        <MenuItem Header="Documentation" Click="MenuAction" />
        <MenuItem Header="Report bug" Click="MenuAction" />
        <MenuItem Header="Debug info" Click="MenuAction" />
      </MenuItem>
    </Menu>

    <Border Grid.Row="1" Background="#EFF0F1" BorderBrush="#BAB9B8" BorderThickness="0,0,0,1">
      <StackPanel Margin="10,0,0,0" Orientation="Horizontal" VerticalAlignment="Bottom">
        <Button x:Name="HomeTab" Classes="tab active" Click="ShowHome"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Classes="tab-icon" Foreground="#E66B43" Data="M8,1 15,7 13,7 13,15 9.5,15 9.5,10 6.5,10 6.5,15 3,15 3,7 1,7z" /><TextBlock Text="Home" /></StackPanel></Button>
        <Button x:Name="HistoryTab" Classes="tab" Click="ShowHistory"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Classes="tab-icon" Foreground="#168ED0" Data="M8,1a7,7 0 1,1-6.2,3.7L0,3v5h5L3,6a5,5 0 1,0 5-3v4H5v2h5V3A5,5 0 0,0 8,1z" /><TextBlock Text="History" /></StackPanel></Button>
        <Button x:Name="SendTab" Classes="tab" Click="ShowSend"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Classes="tab-icon" Foreground="#258DCE" Data="M1,2 15,8 1,14 3.5,9.2 10,8 3.5,6.8z" /><TextBlock Text="Send" /></StackPanel></Button>
        <Button x:Name="ReceiveTab" Classes="tab" Click="ShowReceive"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Classes="tab-icon" Foreground="#7896A2" Data="M7,1h2v8l3-3 1.5,1.5L8,13 2.5,7.5 4,6l3,3z M2,13h12v2H2z" /><TextBlock Text="Receive" /></StackPanel></Button>
        <Button x:Name="CoinsTab" Classes="tab" Click="ShowCoins"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Classes="tab-icon" Foreground="#E58D2B" Data="M8,1c3.9,0 7,1.3 7,3s-3.1,3-7,3-7-1.3-7-3 3.1-3 7-3z M1,6.5C2.5,8 5,8.7 8,8.7s5.5-.7 7-2.2V9c0,1.7-3.1,3-7,3s-7-1.3-7-3z M1,11.5C2.5,13 5,13.7 8,13.7s5.5-.7 7-2.2V13c0,1.7-3.1,3-7,3s-7-1.3-7-3z" /><TextBlock Text="Coins" /></StackPanel></Button>
        <Button x:Name="NotesTab" Classes="tab" Click="ShowNotes"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Classes="tab-icon" Foreground="#9C632F" Data="M2,1h9l3,3v11H2z M10,2v3h3 M4,7h8v1.5H4z M4,10h8v1.5H4z" /><TextBlock Text="Notes" /></StackPanel></Button>
        <Button x:Name="CalcTab" Classes="tab last" Click="ShowCalc"><StackPanel Orientation="Horizontal" Spacing="5"><PathIcon Classes="tab-icon" Foreground="#445057" Data="M2,1h12v14H2z M4,3h8v3H4z M4,8h2v2H4z M7,8h2v2H7z M10,8h2v2h-2z M4,11h2v2H4z M7,11h2v2H7z M10,11h2v2h-2z" /><TextBlock Text="Calc" /></StackPanel></Button>
      </StackPanel>
    </Border>

    <Border Grid.Row="2" Background="#FCFCFC">
      <Grid>
        <Grid x:Name="HomePage" Margin="10,8,10,10" RowDefinitions="63,1,35,29,6,*">
          <Grid ColumnDefinitions="100,8,112,8,104,*,73">
            <StackPanel><TextBlock Margin="0,0,0,4" Text="XMR" /><Border Height="34" BorderBrush="#BAB9B8" BorderThickness="1" CornerRadius="2"><Grid Margin="7,0" ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Text="€201.19" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#158337" Text="+0.9%" /></Grid></Border></StackPanel>
            <StackPanel Grid.Column="2"><TextBlock Margin="0,0,0,4" Text="BTC" /><Border Height="34" BorderBrush="#BAB9B8" BorderThickness="1" CornerRadius="2"><Grid Margin="7,0" ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Text="€77892.25" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#158337" Text="+3.4%" /></Grid></Border></StackPanel>
            <StackPanel Grid.Column="4"><TextBlock Margin="0,0,0,4" Text="XMR/BTC" /><Border Height="34" BorderBrush="#BAB9B8" BorderThickness="1" CornerRadius="2"><Grid Margin="7,0" ColumnDefinitions="*,Auto"><TextBlock VerticalAlignment="Center" Text="0.002583" /><TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="11" Foreground="#D12424" Text="-2.5%" /></Grid></Border></StackPanel>
            <StackPanel Grid.Column="6"><TextBlock Margin="0,0,0,4" Text="Balance" /><Border Height="34" BorderBrush="#BAB9B8" BorderThickness="1" CornerRadius="2"><TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="€4.02" /></Border></StackPanel>
          </Grid>
          <Border Grid.Row="1" Classes="divider" />
          <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Bottom">
            <Button Classes="subtab">Crowdfunding</Button><Button Classes="subtab">Bounties</Button><Button Classes="subtab active">Revuo</Button>
          </StackPanel>
          <Grid Grid.Row="3" ColumnDefinitions="*,38" ColumnSpacing="6">
            <ComboBox SelectedIndex="0"><ComboBoxItem Content="Issue 233: March 23 - 30, 2025" /></ComboBox>
            <Button Grid.Column="1" Classes="tool" HorizontalAlignment="Right" ToolTip.Tip="Open in browser">↗</Button>
          </Grid>
          <Border Grid.Row="4" />
          <Border Grid.Row="5" Classes="table">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Margin="5,4,8,5" Spacing="8">
                <TextBlock FontSize="14" FontWeight="Bold" Text="Recent News" />
                <TextBlock TextWrapping="Wrap" Text="• Monero 0.18.4.0 ‘Fluorine Fermi’ Release has been tagged. Binaries and blog post containing release notes, changelog, to be expected in the next few days. Reach out to your preferred node operators and wallet developers in the meantime!" />
                <TextBlock TextWrapping="Wrap" Text="• Community members launched monero.eco: a map or graph of Monero Ecosystem that aims to provide a visual overview, with web links to relevant XMR projects and services." />
                <TextBlock TextWrapping="Wrap" Text="• MRL contributor Rucknium wrote a simulation of the risk of OSPEAD DSA adoption without a hard fork. A newer, more fine-tuned estimate is expected in the forthcoming weeks." />
                <TextBlock TextWrapping="Wrap" Text="• Moonlight Wallet preview ships with a compact desktop interface and native wallet components." />
                <TextBlock TextWrapping="Wrap" Text="• Cake and Monero.com released background sync and various UI enhancements." />
              </StackPanel>
            </ScrollViewer>
          </Border>
        </Grid>

        <views:HistoryView x:Name="HistoryPage" IsVisible="False" />

        <Grid x:Name="SendPage" IsVisible="False" Margin="10,12,10,10" RowDefinitions="32,32,37,*">
          <Grid ColumnDefinitions="72,*,81" ColumnSpacing="10"><TextBlock VerticalAlignment="Center" Text="Pay to" /><TextBox x:Name="PayToBox" Grid.Column="1" Text="88sDCmPMEhMWKPitFXyJ9hSeFESwE6SAVCTrPo3WiRySiA3J8352Zcx2BTS7pVTb9G3pmxPJ2FpSy89M9nj5nQJ32D" /><Button Grid.Column="2">▣ Scan</Button></Grid>
          <Grid Grid.Row="1" ColumnDefinitions="72,*" ColumnSpacing="10"><TextBlock VerticalAlignment="Center" Text="Description" /><TextBox x:Name="DescriptionBox" Grid.Column="1" Text="Donation to CCS: Moonlight maintenance (2026 Q3)" /></Grid>
          <Grid Grid.Row="2" ColumnDefinitions="72,108,57,80,*,80,80" ColumnSpacing="6"><TextBlock VerticalAlignment="Center" Text="Amount" /><TextBox x:Name="AmountBox" Grid.Column="1" /><ComboBox Grid.Column="2" SelectedIndex="0"><ComboBoxItem Content="XMR" /></ComboBox><Button Grid.Column="3">Max</Button><Button Grid.Column="5" Click="ClearSend">Clear</Button><Button Grid.Column="6" IsEnabled="False">Send</Button></Grid>
        </Grid>

        <views:ReceiveView x:Name="ReceivePage" IsVisible="False" />

        <views:CoinsView x:Name="CoinsPage" IsVisible="False" />

        <TextBox x:Name="NotesPage" IsVisible="False" Margin="0" AcceptsReturn="True" TextWrapping="Wrap" VerticalContentAlignment="Top" />

        <Grid x:Name="CalcPage" IsVisible="False" Margin="10,10,10,10" RowDefinitions="27,*">
          <Grid ColumnDefinitions="*,56,62,*,56" ColumnSpacing="0">
            <TextBox Text="1.5" /><ComboBox Grid.Column="1" SelectedIndex="0"><ComboBoxItem Content="XMR" /></ComboBox>
            <TextBlock Grid.Column="2" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="27" FontWeight="Bold" Text="⇄" />
            <TextBox Grid.Column="3" Text="326.58" /><ComboBox Grid.Column="4" SelectedIndex="0"><ComboBoxItem Content="USD" /></ComboBox>
          </Grid>
          <Button Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,0,0">Configure</Button>
        </Grid>
      </Grid>
    </Border>

    <Border Grid.Row="3" Background="#EFF0F1" BorderBrush="#BAB9B8" BorderThickness="0,1,0,0">
      <Grid Margin="0,0,7,0" ColumnDefinitions="*,Auto,Auto">
        <TextBlock x:Name="StatusText" VerticalAlignment="Center" Text="Synchronized" />
        <TextBlock Grid.Column="1" VerticalAlignment="Center" Margin="0,0,6,0" Text="Balance: 0.019969 XMR (€4.02)" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Button Classes="status-icon" ToolTip.Tip="Connected"><PathIcon Foreground="#52B935" Data="M8,1a7,7 0 1,0 0,14A7,7 0 0,0 8,1z M8,4a4,4 0 1,1 0,8A4,4 0 0,1 8,4z M8,6.5a1.5,1.5 0 1,0 0,3 1.5,1.5 0 0,0 0-3z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Account"><PathIcon Foreground="#E28B20" Data="M8,1a3,3 0 1,1 0,6 3,3 0 0,1 0-6z M2,15c0-4 2-6 6-6s6,2 6,6z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Password"><PathIcon Foreground="#C5A35A" Data="M4,7V5a4,4 0 0,1 8,0v2h2v8H2V7z M6,7h4V5a2,2 0 0,0-4,0z M7,10v3h2v-3z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Settings"><PathIcon Foreground="#768890" Data="M7,1h2l.5,2a6,6 0 0,1 1.4.8l2-.6 1,1.8-1.5,1.4c.1.5.1,1 0,1.6l1.5,1.4-1,1.8-2-.6a6,6 0 0,1-1.4.8l-.5,2H7l-.5-2a6,6 0 0,1-1.4-.8l-2,.6-1-1.8L3.6,8a6,6 0 0,1 0-1.6L2.1,5l1-1.8 2,.6A6,6 0 0,1 6.5,3z M8,5a3,3 0 1,0 0,6 3,3 0 0,0 0-6z" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Seed"><PathIcon Foreground="#C5A924" Data="M8,15V9C4,9 2,7 2,3c4,0 6,2 6,6 0-5 2-7 6-7 0,4-2,7-6,7" /></Button>
          <Button Classes="status-icon" ToolTip.Tip="Proxy"><PathIcon Foreground="#6B972E" Data="M8,1a7,7 0 1,0 0,14A7,7 0 0,0 8,1z M8,3a5,5 0 1,1 0,10A5,5 0 0,1 8,3z M8,5a3,3 0 1,0 0,6 3,3 0 0,0 0-6z" /></Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
