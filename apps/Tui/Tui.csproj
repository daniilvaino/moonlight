<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>moonlight-tui</AssemblyName>
    <RootNamespace>Moonlight.Tui</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantTimezone>true</InvariantTimezone>
    <ApplicationIcon>../../media/favicon.ico</ApplicationIcon>
    <MoonlightHost Condition="'$(MoonlightHost)' == ''">console</MoonlightHost>
  </PropertyGroup>

  <!-- Vendor\TerminalGui\TerminalGui.props sets the same constant for the module.
       The app needs it too: the two hosts differ in what they can report, and one
       of those differences reaches the screens. -->
  <PropertyGroup Condition="'$(MoonlightHost)' == 'sharpos'">
    <DefineConstants>$(DefineConstants);SHARPOS</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Vendor\**\*.cs" />
    <ProjectReference Include="..\..\src\Core.Http\Core.Http.csproj" />
    <ProjectReference Include="Vendor\TerminalGui\TerminalGui.csproj" />
  </ItemGroup>

</Project>
