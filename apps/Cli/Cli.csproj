<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>moonlight</AssemblyName>
    <RootNamespace>Moonlight.Cli</RootNamespace>
    <PublishAot>true</PublishAot>
    <InvariantTimezone>true</InvariantTimezone>
    <ApplicationIcon>../../media/favicon.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- `moonlight version` reports which build it is. bflat is told with -d BFLAT on
       its own command line; here the SDK property is the truth, and the managed
       publish for the release archive turns it off with -p:PublishAot=false. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <DefineConstants>$(DefineConstants);NATIVEAOT</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Core.Http\Core.Http.csproj" />
  </ItemGroup>

  <!-- The version `moonlight version` prints, written as a constant. It has to be
       right in all three build modes, and bflat runs no MSBuild, so it never sees
       $(Version) at all. The bflat builds run this same target to get the file —
       `dotnet msbuild apps/Cli -t:WriteBuildVersion -p:BuildVersionFile=...` — rather
       than carrying a copy of what it writes, so there is one shape for the class and
       not two to drift apart. -->
  <Target Name="WriteBuildVersion" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildVersionFile Condition="'$(BuildVersionFile)' == ''">$(IntermediateOutputPath)BuildVersion.g.cs</BuildVersionFile>
    </PropertyGroup>

    <WriteLinesToFile
      File="$(BuildVersionFile)"
      Overwrite="true"
      WriteOnlyWhenDifferent="true"
      Lines="// Generated from VERSION by apps/Cli/Cli.csproj. Not checked in.;namespace Moonlight.Cli%3B;internal static class BuildVersion { public const string Value = &quot;$(Version)&quot;%3B }" />

    <ItemGroup>
      <Compile Include="$(BuildVersionFile)" />
    </ItemGroup>
  </Target>

</Project>
